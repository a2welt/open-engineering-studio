# Copy to .env.local to change how the Studio reaches its backends.

# Repo X-Ray: "auto" tries `xray serve` and falls back to the bundled sample,
# "http" always uses the server, "mock" always uses the sample.
VITE_XRAY_MODE=auto
VITE_XRAY_BASE_URL=/xray
XRAY_TARGET=http://127.0.0.1:8765

# OpenAgentTrust: "mock" (default) works without a server; "http" calls `oat serve`.
VITE_OAT_MODE=mock
VITE_OAT_BASE_URL=/oat
OAT_TARGET=http://127.0.0.1:8787
# The same token `oat serve` reads. The dev proxy sends it; it is never bundled.
OAT_API_TOKEN=
# Override any endpoint path (JSON, partial is fine). {id} and {digest} are filled in.
# VITE_OAT_PATHS={"receipts":"/v1/receipts?limit=200"}
